{
  "version": 2,
  "description": "Combined evaluation cases: all visible cases from the assignment plus original cases covering additional behaviors.",
  "cases": [
    {
      "id": "standard-return-window",
      "category": "retrieval",
      "messages": [
        {"role": "user", "content": "How long does a regular customer have to return an unused backpack?"}
      ],
      "expect": {
        "must_include": ["30"],
        "must_not_include": ["60 days", "free return label"],
        "required_sources": ["01-returns-policy-current.md"],
        "forbidden_sources": ["02-returns-policy-legacy.md", "14-internal-content-migration-notes.md"],
        "tool": "not_called",
        "handoff": false
      }
    },
    {
      "id": "trailplus-return-window",
      "category": "retrieval",
      "messages": [
        {"role": "user", "content": "My TrailPlus membership was active when I ordered. What is my return window?"}
      ],
      "expect": {
        "must_include": ["45"],
        "required_sources": ["09-trailplus-membership.md"],
        "tool": "not_called",
        "handoff": false
      }
    },
    {
